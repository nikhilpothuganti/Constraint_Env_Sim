+extern int32_t zetas_ntt_8l_rv32im[512];
+extern int32_t zetas_intt_8l_rv32im[512];
+extern void ntt_8l_rv32im(int32_t *r, int32_t *zetas);
+extern void intt_8l_rv32im(int32_t *r, int32_t *zetas);
+#endif
